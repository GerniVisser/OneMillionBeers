# Local development environment variables.
# Copy to .env.local — that file is gitignored and safe to customise.

# -------------------
# Backend API
# -------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/omb
LOG_LEVEL=debug

# -------------------
# Collector (shared by all collector services)
# -------------------
BACKEND_URL=http://127.0.0.1:3000
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_PUBLIC_URL=http://127.0.0.1:9000
STORAGE_BUCKET=omb-photos
STORAGE_KEY=minioadmin
STORAGE_SECRET=minioadmin
STORAGE_REGION=auto

# WhatsApp collector (WAHA) — local dev
# collector-whatsapp runs on the host via pnpm dev; WAHA runs in Docker (docker-compose.local.yml)
WAHA_BASE_URL=http://localhost:3100
WAHA_API_KEY=local-api-key
WAHA_WEBHOOK_URL=http://localhost:8080/webhook
# The origin the admin page is opened on (http://localhost:8080/admin when hitting
# the collector directly; http://localhost/admin through a local nginx).
PUBLIC_BASE_URL=http://localhost:8080
# Admin page login for local dev: username `admin`, password `local-admin-password`.
# Never reuse these values anywhere else.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:32768:8:1:N4Cx9cwwma4YpI6UWId9JQ:h6xV7IksmcL6K-9HnS0exRuuCzPLW6jMopP5ZNkj7rc
ADMIN_SESSION_SECRET=local-admin-session-secret-not-for-production
# ENABLE_ALERTS defaults to false — SES vars are not needed in local dev

# -------------------
# Internal API auth (collector -> backend)
# -------------------
# Shared secret for /v1/internal/*. Any string of 32+ characters works locally;
# production uses a random value from SSM Parameter Store.
INTERNAL_API_TOKEN=dev-internal-token-not-for-production-use

# -------------------
# Frontend
# ORIGIN is only required for `pnpm preview` (adapter-node production mode).
# PORT is not needed for `pnpm dev` — Vite uses --port 3001 from the package script.
# -------------------
ORIGIN=http://127.0.0.1:3001
BACKEND_INTERNAL_URL=http://127.0.0.1:3000
