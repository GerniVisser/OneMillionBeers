# -------------------
# Backend API
# -------------------
DATABASE_URL=postgres://postgres:postgres@postgres:5432/omb
LOG_LEVEL=info

# -------------------
# Collector (shared by all collector services)
# -------------------
BACKEND_URL=http://backend:3000
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=omb-photos
STORAGE_KEY=minioadmin
STORAGE_SECRET=minioadmin
STORAGE_REGION=auto
LOG_LEVEL=info

# WhatsApp collector (WAHA)
WAHA_API_KEY=your-strong-waha-api-key-here
WAHA_WEBHOOK_URL=http://collector-whatsapp:8080/webhook
# PUBLIC_BASE_URL is the site's public domain — used to construct the /whatsapp/status link in alert emails
PUBLIC_BASE_URL=https://onemillionbeers.co.za
# STATUS_TOKEN must be a cryptographically random string of at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATUS_TOKEN=generate-a-random-32-char-hex-string
ENABLE_ALERTS=false
ALERT_EMAIL=you@example.com
# SES_FROM_EMAIL must be on a domain (or be an address) verified in SES for AWS_REGION,
# otherwise every alert is rejected with MessageRejected and outages go unnoticed.
# Check with: aws sesv2 list-email-identities
SES_FROM_EMAIL=alerts@yourdomain.com
AWS_REGION=us-east-1

# -------------------
# Internal API auth (collector -> backend)
# -------------------
# Shared secret for /v1/internal/*. The backend rejects these routes without it
# and refuses to start if it is unset; the collector presents it as a bearer
# token. Must be identical for both services and at least 32 characters.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=generate-a-random-32-byte-hex-string

# -------------------
# Frontend
# -------------------
ORIGIN=https://onemillionbeers.co.za  # Required by adapter-node in production
PORT=3001
BACKEND_INTERNAL_URL=http://backend:3000
