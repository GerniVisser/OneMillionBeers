# -------------------
# Backend API
# -------------------
DATABASE_URL=postgres://postgres:postgres@postgres:5432/omb
LOG_LEVEL=info

# -------------------
# Collector (shared by all collector services)
# -------------------
BACKEND_URL=http://backend:3000
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=omb-photos
STORAGE_KEY=minioadmin
STORAGE_SECRET=minioadmin
STORAGE_REGION=auto
LOG_LEVEL=info

# WhatsApp collector (WAHA)
WAHA_API_KEY=your-strong-waha-api-key-here
# WAHA dashboard login; unset, WAHA generates one on every start.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=generate-with-openssl-rand-hex-24
# Where the CloudWatch alarms email (infra/alerts.tf reads it from SSM); no service uses it.
ALERT_EMAIL=you@example.com

# Tailscale: operator access to the WAHA dashboard (doc/INFRA.md).
# Single-use, tagged tag:omb-server; only read while the container has no saved state.
TS_AUTHKEY=

# -------------------
# Internal API auth (collector -> backend)
# -------------------
# Shared secret for /v1/internal/*. The backend rejects these routes without it
# and refuses to start if it is unset; the collector presents it as a bearer
# token. Must be identical for both services and at least 32 characters.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=generate-a-random-32-byte-hex-string

# -------------------
# Frontend
# -------------------
ORIGIN=https://onemillionbeers.co.za  # Required by adapter-node in production
PORT=3001
BACKEND_INTERNAL_URL=http://backend:3000
